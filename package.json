{
  "name": "jl-law-firm",
  "version": "1.0.0",
  "description": "Modern website for JL Law Firm - Professional legal services",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:css": "npx tailwindcss -i ./src/styles/main.css -o ./public/site.css && cp ./public/site.css ./site.css",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "nodemon server/index.js",
    "start": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "jest --testPathPattern=tests/a11y",
    "test:visual": "playwright test --grep @visual",
    "test:all": "npm run test && npm run test:e2e && npm run test:a11y",
    "lighthouse": "lhci autorun",
    "validate:html": "node scripts/validate-html.js",
    "validate:a11y": "node scripts/validate-a11y.js",
    "precommit": "npm run lint:check && npm run format:check && npm run test"
  },
  "keywords": [
    "law-firm",
    "legal-services",
    "website"
  ],
  "author": "JL Law Firm",
  "license": "ISC",
  "devDependencies": {
    "vite": "^5.4.11",
    "vite-plugin-compression": "^0.5.1",
    "terser": "^5.36.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-playwright": "^0.20.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "cssnano": "^7.0.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/user-event": "^14.5.1",
    "@playwright/test": "^1.40.1",
    "playwright": "^1.40.1",
    "@axe-core/playwright": "^4.8.2",
    "axe-core": "^4.8.3",
    "@lhci/cli": "^0.13.0",
    "html-validator": "^6.0.1",
    "pa11y": "^8.0.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "glob": "^10.3.10",
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
